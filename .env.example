# Supabase — 클라이언트(브라우저)에서 사용하는 공개 키
# Vite는 VITE_ 접두사가 붙은 변수만 클라이언트 번들에 노출합니다.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase — 서버(Vercel Serverless Functions)에서만 사용하는 비밀 키
# 절대 클라이언트에 노출하지 마세요. (VITE_ 접두사 사용 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 관리자 인증(커스텀 JWT) 서명 비밀 키 — 서버 전용. 충분히 긴 랜덤 문자열 사용
# 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your-long-random-jwt-secret

# 시드 스크립트용 초기 관리자 비밀번호(영문+숫자 8자 이상)
SEED_OWNER_PASSWORD=owner1234
SEED_STAFF_PASSWORD=staff1234

# DB 마이그레이션(psql)용 접속 문자열 — Supabase 대시보드 → Project Settings → Database →
# Connection string(URI) 에서 확인. [YOUR-PASSWORD] 자리에 DB 비밀번호를 넣으세요.
# 예: postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
# (npm run db:migrate / db:setup 에서 사용. 커밋 금지)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
